{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["ingest", "fleet"],
  "properties": {
    "ingest": {
      "type": "object",
      "required": ["image", "sourceRevision", "databaseHost", "memory"],
      "properties": {
        "image": {"type": "string", "pattern": "^ghcr\\.io/[a-z0-9./_-]+@sha256:[a-f0-9]{64}$"},
        "sourceRevision": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "databaseHost": {"type": "string", "minLength": 1},
        "memory": {"type": "string", "pattern": "^[1-9][0-9]*Mi$"}
      }
    },
    "fleet": {
      "type": "object",
      "required": ["image"],
      "properties": {
        "image": {"type": "string", "pattern": "^ghcr\\.io/[a-z0-9./_-]+@sha256:[a-f0-9]{64}$"}
      }
    }
  }
}
